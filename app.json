{
  "expo": {
    "name": "icare-life-learn-mobile",
    "slug": "icare-life-learn-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/android-icon-foreground.png",
    "scheme": "icarelifelearnmobile",
    "userInterfaceStyle": "automatic",
    "ios": {h
      "supportsTablet": true,
      "bundleIdentifier": "life.icare.app,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/android-icon-foreground.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
              "minSdkVersion": 24,
              "compileSdkVersion": 36,
              "targetSdkVersion": 36,
              "buildToolsVersion": "36.0.0",
              "extraMavenRepos": [],
              "newArchEnabled": false
          },
          "ios": {
            "deploymentTarget": "16.4",
            "newArchEnabled": false
          }
        }
      ],
      "./modules/icare-offline-drm/app.plugin.js",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "isTablet": true,
      "package": "life.icare.app"
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC"
      ]
    },
    "experiments": {
      "typedRoutes": true,
      "newArchEnabled": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f2a8c774-4137-4a21-9291-4734746371bb"
      }
    }
  }
}
