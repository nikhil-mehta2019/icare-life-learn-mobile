android/build/
android/app/build/
android/app/.cxx/
android/.gradle/
modules/icare-offline-drm/android/build/
modules/icare-offline-drm/android/.gradle/

# Local IDE / tooling state
.idea/
.claude/
*.log

# Not needed in the build archive
screenshots/
docs/
